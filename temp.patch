From f288230684a183fd9a6ad4a43d8c2a0a9a7c3c74 Mon Sep 17 00:00:00 2001
From: Donella Kreiger <ahlyl94@gmail.com>
Date: Fri, 9 Aug 2024 20:08:37 +0800
Subject: [PATCH] [Game] Teleport Book cannot be used when not in the main
 world (#1067)

---
 AAEmu.Game/Models/Game/Skills/Skill.cs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/AAEmu.Game/Models/Game/Skills/Skill.cs b/AAEmu.Game/Models/Game/Skills/Skill.cs
index 3293116c80..4ce81163ca 100644
--- a/AAEmu.Game/Models/Game/Skills/Skill.cs
+++ b/AAEmu.Game/Models/Game/Skills/Skill.cs
@@ -247,6 +247,14 @@ public SkillResult Use(BaseUnit caster, SkillCaster casterCaster, SkillCastTarge
             return SkillResult.TooFarRange;
         }
 
+        if (Template.Effects.Count > 0 && Template.Effects.First()?.Template is OpenPortalEffect)
+        {
+            if (0 != caster.InstanceId)
+            {
+                return SkillResult.InvalidLocation;
+            }
+        }
+
         // Calculate casting time if needed
         var castTime = 0;
         if (Template.CastingTime > 0)
