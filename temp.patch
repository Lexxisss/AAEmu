From 791ea9e6ac17d8756f32fa4117b15703d1a3e8c6 Mon Sep 17 00:00:00 2001
From: Donella Kreiger <ahlyl94@gmail.com>
Date: Wed, 14 Aug 2024 16:38:54 +0800
Subject: [PATCH] [Game] When a character is level change or a zone change
 occurs, update the information in the expedition team. (#1078)

---
 AAEmu.Game/Core/Managers/ExpeditionManager.cs          | 1 +
 AAEmu.Game/Models/Game/Char/Character.cs               | 3 +++
 AAEmu.Game/Models/Game/Expeditions/Expedition.cs       | 9 +++++++++
 AAEmu.Game/Models/Game/Expeditions/ExpeditionMember.cs | 5 ++++-
 4 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/AAEmu.Game/Core/Managers/ExpeditionManager.cs b/AAEmu.Game/Core/Managers/ExpeditionManager.cs
index f5564eac83..d0166f8c1c 100644
--- a/AAEmu.Game/Core/Managers/ExpeditionManager.cs
+++ b/AAEmu.Game/Core/Managers/ExpeditionManager.cs
@@ -663,6 +663,7 @@ public static ExpeditionMember GetMemberFromCharacter(uint characterId)
         member.Abilities = [(byte)character.Ability1, (byte)character.Ability2, (byte)character.Ability3];
         member.ExpeditionId = expedition.Id;
         member.CharacterId = character.Id;
+        member.LastWorldLeaveTime = DateTime.UtcNow;
 
         return member;
     }
diff --git a/AAEmu.Game/Models/Game/Char/Character.cs b/AAEmu.Game/Models/Game/Char/Character.cs
index 0d7499b47d..9df9ffb3bd 100644
--- a/AAEmu.Game/Models/Game/Char/Character.cs
+++ b/AAEmu.Game/Models/Game/Char/Character.cs
@@ -1357,6 +1357,7 @@ public void CheckLevelUp()
             change = true;
             Level++;
             needExp = ExperienceManager.Instance.GetExpForLevel((byte)(Level + 1));
+            Expedition?.OnCharacterRefresh(this);
         }
 
         if (change)
@@ -1377,6 +1378,7 @@ public void CheckExp()
         {
             Level++;
             needExp = ExperienceManager.Instance.GetExpForLevel((byte)(Level + 1));
+            Expedition?.OnCharacterRefresh(this);
         }
     }
 
@@ -1577,6 +1579,7 @@ public void OnZoneChange(uint lastZoneKey, uint newZoneKey)
         }
         if (newZone != null)
         {
+            Expedition?.OnCharacterRefresh(this);
             // Apply the new zone buff if needed
             var newZoneGroup = ZoneManager.Instance.GetZoneGroupById(newZone.GroupId);
             if ((newZoneGroup != null) && (newZoneGroup.BuffId != 0))
diff --git a/AAEmu.Game/Models/Game/Expeditions/Expedition.cs b/AAEmu.Game/Models/Game/Expeditions/Expedition.cs
index 0046e34b49..cc4b371e83 100644
--- a/AAEmu.Game/Models/Game/Expeditions/Expedition.cs
+++ b/AAEmu.Game/Models/Game/Expeditions/Expedition.cs
@@ -269,4 +269,13 @@ public PacketStream WriteInfo(PacketStream stream)
         stream.Write(0u);                // type
         return stream;
     }
+
+    public void OnCharacterRefresh(Character character)
+    {
+        var member = GetMember(character);
+        if (member == null)
+            return;
+        member.Refresh(character);
+        SendPacket(new SCExpeditionMemberStatusChangedPacket(member, 0));
+    }
 }
diff --git a/AAEmu.Game/Models/Game/Expeditions/ExpeditionMember.cs b/AAEmu.Game/Models/Game/Expeditions/ExpeditionMember.cs
index d30741e19d..8b045df8e4 100644
--- a/AAEmu.Game/Models/Game/Expeditions/ExpeditionMember.cs
+++ b/AAEmu.Game/Models/Game/Expeditions/ExpeditionMember.cs
@@ -38,7 +38,10 @@ public void Refresh(Character character)
         InParty = character.InParty;
         Position = character.Transform.World.Position;
         ZoneId = character.Transform.ZoneId;
-        Abilities = [(byte)character.Ability1, (byte)character.Ability2, (byte)character.Ability3];
+        Abilities = new[] { (byte)character.Ability1, (byte)character.Ability2, (byte)character.Ability3 };
+        Level = character.Level;
+        Name = character.Name;
+        LastWorldLeaveTime = DateTime.UtcNow;
     }
 
     public void Save(MySqlConnection connection, MySqlTransaction transaction)
